{
  "manifest_version": 3,
  "name": "SlashPrompt — Local AI Prompt Enhancer",
  "version": "1.0.0",
  "description": "Type // followed by any rough prompt in any text area to enhance, rewrite, or proofread it locally using Chrome's Built-in AI (Gemini Nano) — zero tokens, zero API keys.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SlashPrompt — Local AI Prompt Enhancer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
